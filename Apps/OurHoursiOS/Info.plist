<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CKSharingSupported</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OurHours</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>画面を閉じている間も、ペアのiPhoneが近くにあった日と時間をBluetoothで自動記録するために使用します。</string>
	<key>NSCameraUsageDescription</key>
	<string>ペア設定用のQRコードを読み取るためにカメラを使用します。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Bluetoothが届きにくいバックグラウンド中も「一緒にいる時間」の取りこぼしを防ぐため、暗号化した位置滞在ログをペア間でのみ突き合わせて記録補完に使用します（画面への地図や座標の表示は行いません）。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Bluetoothの記録補完として、暗号化した位置滞在ログをペア間でのみ突き合わせて「一緒にいる時間」を正確に集計するために使用します（地図や座標の表示は行いません）。</string>
	<key>UIAppFonts</key>
	<array>
		<string>ZenMaruGothic-Regular.ttf</string>
		<string>ZenMaruGothic-Medium.ttf</string>
		<string>ZenMaruGothic-Bold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
